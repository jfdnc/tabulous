{
  "name": "tabulous",
  "version": "1.0.0",
  "description": "MCP-powered tab completion generation for CLI tools",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "tabulous": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "lint": "eslint src/**/*.ts",
    "lint:fix": "eslint src/**/*.ts --fix"
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "tab-completion",
    "cli",
    "shell-completion",
    "bash",
    "zsh",
    "fish"
